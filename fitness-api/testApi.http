  "stream": false
}

### =====================================================
### 9. 通用上传模块
### =====================================================

### 上传图片
POST {{baseUrl}}/api/common/upload/image
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./test-image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 上传视频（最大 100MB）
POST {{baseUrl}}/api/common/upload/video
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.mp4"
Content-Type: video/mp4

< ./test-video.mp4
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 注意：如果视频超过 100MB，将返回 400 错误：
### HTTP/1.1 400 Bad Request
### {"code": 400, "message": "视频文件过大，不能超过 100MB，当前大小：xxx MB", "data": null}
